// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         String   @default("user")
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  newsBookmarks   NewsBookmark[]
  marketBookmarks MarketBookmark[]
  videoBookmarks  VideoBookmark[]
}

model News {
  id             Int      @id @default(autoincrement())
  title          String
  link           String   @unique
  pubDate        String
  contentSnippet String
  createdAt      DateTime @default(now())

  categoryId    Int?
  category      Category?      @relation(fields: [categoryId], references: [id])
  newsBookmarks NewsBookmark[]
}

model NewsBookmark {
  id     Int @id @default(autoincrement())
  userId Int
  newsId Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  news News @relation(fields: [newsId], references: [id])

  @@unique([userId, newsId])
}

model MarketBookmark {
  id Int @id @default(autoincrement())

  userId   Int
  marketId Int

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId])
}

model VideoBookmark {
  id      Int @id @default(autoincrement())
  userId  Int
  videoId Int

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Market {
  id        Int      @id @default(autoincrement())
  coinId    String   @unique
  name      String?
  symbol    String?
  createdAt DateTime @default(now())

  marketBookmarks MarketBookmark[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  news News[]
}

enum VideoState {
  VIDEO
  UPCOMING
  LIVE
  ENDED
  UNAVAILABLE
}

model Video {
  id               Int        @id @default(autoincrement())
  externalId       String     @unique
  provider         String     @default("youtube")
  channelId        String
  channelTitle     String
  title            String
  description      String
  watchUrl         String
  embedUrl         String?
  thumbnailUrl     String?
  publishedAt      DateTime
  durationSeconds  Int?
  state            VideoState @default(VIDEO)
  scheduledStartAt DateTime?
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  syncedAt         DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  videoBookmarks VideoBookmark[]

  @@index([state, publishedAt])
  @@index([channelId])
}
